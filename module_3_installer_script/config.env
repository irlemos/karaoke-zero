# ==============================================================================
# KaraokeZero - Module 3: Deployment Configuration File
# ==============================================================================
# If all required fields (STORAGE_TYPE, STORAGE_DEVICE/SD_CARD_STORAGE_PATH,
# ADMIN_WIFI_SSID, and ADMIN_WIFI_PASSWORD) are set, the installer executes
# in 100% unattended mode without prompting the user.
#
# If any required field is empty or missing, install.sh will interactively
# prompt for the missing settings before proceeding.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Storage Configuration
# ------------------------------------------------------------------------------
# STORAGE_TYPE:
#   - "external_hd" : Recommended. Uses an external USB drive/SSD.
#   - "sd_card"     : Not recommended. Uses the internal MicroSD card.
# Leave empty ("") to trigger interactive selection and warning prompt.
STORAGE_TYPE=""

# For STORAGE_TYPE="external_hd":
# Specify the partition device (e.g., /dev/sda1) or UUID (e.g., UUID=1234-ABCD).
# Leave empty ("") to interactively choose from detected USB drives.
STORAGE_DEVICE=""

# Mount point for the external storage (default: /mnt/external_hd/karaoke)
MOUNT_POINT="/mnt/external_hd/karaoke"

# For STORAGE_TYPE="sd_card":
# Custom directory path on the SD card (e.g., /var/lib/karaokezero).
SD_CARD_STORAGE_PATH=""

# ------------------------------------------------------------------------------
# 2. Initial Fallback Network Configuration (Admin Hotspot)
# ------------------------------------------------------------------------------
# Pre-configures NetworkManager with an autoconnect priority of 100.
# The Pi will connect to this network on boot whenever no venue Wi-Fi is reachable.
# Leave empty ("") to be prompted interactively during installation.
ADMIN_WIFI_SSID=""
ADMIN_WIFI_PASSWORD=""

# ------------------------------------------------------------------------------
# 3. Network Ports & Services
# ------------------------------------------------------------------------------
# Web interface port for PiKaraoke core
PIKARAOKE_PORT=5555

# Web interface port for Module 1 Wi-Fi Manager Captive Portal
WIFI_MANAGER_PORT=8888

# ------------------------------------------------------------------------------
# 4. Upstream Repository & Installation Paths
# ------------------------------------------------------------------------------
PIKARAOKE_REPO_URL="https://github.com/vicwomg/pikaraoke.git"
PIKARAOKE_BRANCH="master"
PIKARAOKE_INSTALL_DIR="/opt/pikaraoke"
KARAOKEZERO_INSTALL_DIR="/opt/karaokezero"

# ------------------------------------------------------------------------------
# 5. Hardware & Firmware Optimizations
# ------------------------------------------------------------------------------
# Configure /boot/config.txt with gpu_mem=128 and hdmi_drive=2
CONFIGURE_BOOT_CONFIG="true"

# Suppress blinking terminal cursor on framebuffer via /boot/cmdline.txt
SUPPRESS_FB_CURSOR="true"

# Automatically enable and start systemd services at end of installation
ENABLE_SERVICES_NOW="true"
