# ==============================================================================
# KaraokeZero - Example Unattended Configuration Template
# ==============================================================================
# Copy this file to config.env to run automated / headless deployments.
# ==============================================================================

# Storage Configuration
STORAGE_TYPE="external_hd"
STORAGE_DEVICE="/dev/sda1"
MOUNT_POINT="/mnt/external_hd/karaoke"
SD_CARD_STORAGE_PATH=""

# Initial Fallback Wi-Fi (Priority 100 Admin Hotspot)
ADMIN_WIFI_SSID="KaraokeAdminPhone"
ADMIN_WIFI_PASSWORD="MySecureHotspotPassword123"

# Network Ports
PIKARAOKE_PORT=5555
WIFI_MANAGER_PORT=8888

# Repository Paths (always tracks latest master without tag pinning)
PIKARAOKE_REPO_URL="https://github.com/vicwomg/pikaraoke.git"
PIKARAOKE_BRANCH="master"
PIKARAOKE_INSTALL_DIR="/opt/pikaraoke"
KARAOKEZERO_INSTALL_DIR="/opt/karaokezero"

# Hardware Tuning
CONFIGURE_BOOT_CONFIG="true"
SUPPRESS_FB_CURSOR="true"
ENABLE_SERVICES_NOW="true"
