[Unit]
Description=KaraokeZero System Admin & Configuration Panel
After=network.target NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/karaokezero/admin_panel
ExecStart=/usr/bin/python3 /opt/karaokezero/admin_panel/app.py
Restart=always
RestartSec=5
Environment=PORT=8888
Environment=HOST=0.0.0.0
Environment=PYTHONUNBUFFERED=1

# Process priority & Resource management
# Nice=10 allows yt-dlp & ffmpeg to consume 100% of available CPU during standby/idle,
# while yielding CPU priority immediately to real-time MPV audio/video during active playback.
Nice=10

[Install]
WantedBy=multi-user.target
