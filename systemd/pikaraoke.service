[Unit]
Description=PiKaraoke Core Headless Background Service
RequiresMountsFor=/mnt/external_hd/karaoke
After=local-fs.target network.target NetworkManager.service
Wants=network.target

[Service]
Type=simple
User=karaoke
Group=karaoke
SupplementaryGroups=video audio render input
WorkingDirectory=/opt/pikaraoke
ExecStart=/opt/pikaraoke/venv/bin/python -m pikaraoke.app \
    --headless \
    --port 5555 \
    --download-path /mnt/external_hd/karaoke/songs \
    --config-file-path /mnt/external_hd/karaoke/data/config.ini
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

# Memory & Process isolation
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
