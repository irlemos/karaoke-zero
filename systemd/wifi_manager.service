[Unit]
Description=KaraokeZero WiFi Manager Captive Portal
After=network.target NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/karaokezero/wifi_manager
ExecStart=/usr/bin/python3 /opt/karaokezero/wifi_manager/app.py
Restart=always
RestartSec=5
Environment=PORT=8888
Environment=HOST=0.0.0.0
Environment=PYTHONUNBUFFERED=1

# Resource management & Low footprint constraints
CPUQuota=25%
MemoryMax=64M

[Install]
WantedBy=multi-user.target
